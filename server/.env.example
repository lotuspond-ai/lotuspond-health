# Copy to server/.env (or set these in your host's environment). All are optional in development.

# PostgreSQL connection. Leave unset to use the embedded PGlite database in DATA_DIR.
# DATABASE_URL=postgres://lotuspond:password@localhost:5432/lotuspond

# Uploaded originals (and the embedded database) are stored here.
# DATA_DIR=.data

# PORT=8787
# HOST=0.0.0.0

# Send the session cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# Set to false only when serving plain http on localhost.
# COOKIE_SECURE=true

# Behind a reverse proxy (nginx, a load balancer): read the client address from X-Forwarded-For.
# TRUST_PROXY=true

# Public address of this server. AI agents (Claude, ChatGPT, …) connect to PUBLIC_URL/mcp and sign in through
# PUBLIC_URL/oauth; set it so the addresses in their metadata are right behind a proxy. Derived from the request when unset.
# PUBLIC_URL=https://health.lotuspond.ai

# Extra origins allowed to make changes, comma-separated (only if the frontend is served from another host).
# APP_ORIGINS=https://app.example.com

# SESSION_DAYS=30
# MAX_UPLOAD_MB=50

# Built frontend to serve. Defaults to ../dist in production.
# STATIC_DIR=/srv/lotuspond/dist

# ---- Mobile apps ----
# Origins of the iOS and Android apps, allowed to call the API cross-origin with bearer tokens (no cookies).
# APP_CLIENT_ORIGINS=capacitor://localhost,https://localhost
# When regions run on separate hosts, each region's API origin (returned by /api/auth/config and with wrong_region errors):
# REGION_API_ORIGINS=in=https://in.health.lotuspond.ai,eu=https://eu.health.lotuspond.ai

# ---- Nearby labs and facilities ----
# Public listings come from OpenStreetMap (Overpass); area and postcode search from Nominatim.
# Queries are made by this server, rounded to about 1 km, and cached in the database
# (places 7 days, geocoding 30 days). Set FACILITY_SEARCH=off to turn both off (partner labs still show).
# FACILITY_SEARCH=on
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# GEOCODER_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy asks for an identifying User-Agent with a contact address. Set this in production.
# GEO_CONTACT_EMAIL=ops@example.com
# GEO_TIMEOUT_MS=20000
# Development only: answer from the recorded responses in server/data/fixtures (Indiranagar, Bengaluru).
# FACILITY_PROVIDER=fixture

# ---- Map tiles (see tools/maps/README.md) ----
# A self-hosted Protomaps basemap. Either a URL, or a file in MAP_TILES_DIR served by this server:
# MAP_TILES_DIR=/srv/lotuspond/maps
# MAP_PMTILES_URL=/api/map/files/india.pmtiles
# Fonts and sprites for that style (self-host them for no third-party requests):
# MAP_ASSETS_URL=/api/map/files/assets
# Or any MapLibre style:
# MAP_STYLE_URL=https://tiles.example.com/style.json
# With neither set, OpenStreetMap's raster tiles are used (fine for development; see their tile usage policy).
# ---------------------------------------------------------------------------------------------------------------
# Secrets. Required when NODE_ENV=production; in development they are generated once in DATA_DIR/secrets.
# Generate each with: openssl rand -base64 32. Keep them in a secret store and back them up: losing
# DIRECTORY_SECRET means accounts cannot be found at sign-in, losing a file key means its files cannot be read.
# ---------------------------------------------------------------------------------------------------------------

# HMAC key for the email directory (which cell holds each account); also keys the address hashes in the audit log.
# DIRECTORY_SECRET=

# AES-256-GCM key for uploaded files (32 bytes, base64).
# FILE_ENCRYPTION_KEY=
# Older keys still accepted for reading during a rotation, comma-separated. See README, "Rotating the file key".
# FILE_ENCRYPTION_PREVIOUS_KEYS=
# Only to store files unencrypted on purpose (the server warns at start-up).
# FILE_ENCRYPTION=off

# `npm run local` sets this so the production build can generate its own secrets on a laptop. Never on a server.
# LOCAL_SECRETS=true

# ---------------------------------------------------------------------------------------------------------------
# Data-residency cells (docs/research.md §2). Each region is a cell: its own database and file store.
# Without any CELL_* settings every served region uses the default database (DATABASE_URL) and DATA_DIR/files.
# ---------------------------------------------------------------------------------------------------------------

# Regions this deployment holds records for: all, or a comma-separated list of in, eu, us, global.
# Sign-up for a country in another region is refused with a message saying where its records are kept.
# SERVED_REGIONS=all

# A cell with its own PostgreSQL database. Its files go to CELL_<REGION>_DATA_DIR/files, or DATA_DIR/cells/<region>/files.
# CELL_IN_DATABASE_URL=postgres://lotuspond:password@db-mumbai:5432/lotuspond_in
# CELL_EU_DATABASE_URL=postgres://lotuspond:password@db-frankfurt:5432/lotuspond_eu
# CELL_US_DATABASE_URL=
# CELL_GLOBAL_DATABASE_URL=

# A cell's own directory: its files, and its embedded database when it has no CELL_<REGION>_DATABASE_URL.
# CELL_IN_DATA_DIR=/srv/lotuspond/cells/in

# A cell's own file key (and previous keys); without one it uses FILE_ENCRYPTION_KEY.
# CELL_IN_FILE_ENCRYPTION_KEY=
# CELL_IN_FILE_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------------------------------------------
# Published contacts and records (Account page)
# ---------------------------------------------------------------------------------------------------------------

# Grievance officer, shown to accounts in India (DPDP Act). The server warns at start-up when India is served without it.
# GRIEVANCE_CONTACT=Priya Sharma, Grievance Officer, grievance@example.com
# Data protection officer, shown to everyone.
# DPO_CONTACT=Data Protection Officer, dpo@example.com

# Account events (sign-ins, exports, deletions) are kept this many days.
# AUDIT_RETENTION_DAYS=400

# ---- Lab booking (docs/lab-booking-backend.md) ----
# Lab partners for home sample collection, comma-separated. Only "fake" exists so far: a simulated lab that runs
# inside the server, for development and tests (refused in production). On by default in development; set
# LAB_PARTNERS= (empty) to turn it off. Its orders move one step every LAB_FAKE_STEP_MS.
# LAB_PARTNERS=fake
# LAB_FAKE_STEP_MS=10000
