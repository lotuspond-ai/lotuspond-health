# Copy to server/.env (or set these in your host's environment). All are optional in development.

# PostgreSQL connection. Leave unset to use the embedded PGlite database in DATA_DIR.
# DATABASE_URL=postgres://lotuspond:password@localhost:5432/lotuspond

# Uploaded originals (and the embedded database) are stored here.
# DATA_DIR=.data

# PORT=8787
# HOST=0.0.0.0

# Send the session cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# Set to false only when serving plain http on localhost.
# COOKIE_SECURE=true

# Behind a reverse proxy (nginx, a load balancer): read the client address from X-Forwarded-For.
# TRUST_PROXY=true

# Extra origins allowed to make changes, comma-separated (only if the frontend is served from another host).
# APP_ORIGINS=https://app.example.com

# SESSION_DAYS=30
# MAX_UPLOAD_MB=50

# Built frontend to serve. Defaults to ../dist in production.
# STATIC_DIR=/srv/lotuspond/dist

# ---- Nearby labs and facilities ----
# Public listings come from OpenStreetMap (Overpass); area and postcode search from Nominatim.
# Queries are made by this server, rounded to about 1 km, and cached in the database
# (places 7 days, geocoding 30 days). Set FACILITY_SEARCH=off to turn both off (partner labs still show).
# FACILITY_SEARCH=on
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# GEOCODER_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy asks for an identifying User-Agent with a contact address. Set this in production.
# GEO_CONTACT_EMAIL=ops@example.com
# GEO_TIMEOUT_MS=20000
# Development only: answer from the recorded responses in server/data/fixtures (Indiranagar, Bengaluru).
# FACILITY_PROVIDER=fixture

# ---- Map tiles (see tools/maps/README.md) ----
# A self-hosted Protomaps basemap. Either a URL, or a file in MAP_TILES_DIR served by this server:
# MAP_TILES_DIR=/srv/lotuspond/maps
# MAP_PMTILES_URL=/api/map/files/india.pmtiles
# Fonts and sprites for that style (self-host them for no third-party requests):
# MAP_ASSETS_URL=/api/map/files/assets
# Or any MapLibre style:
# MAP_STYLE_URL=https://tiles.example.com/style.json
# With neither set, OpenStreetMap's raster tiles are used (fine for development; see their tile usage policy).
