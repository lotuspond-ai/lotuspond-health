{
  "name": "lotuspond-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "partners:import": "tsx src/facilities/import-cli.ts",
    "partners:import:prod": "node dist/facilities/import-cli.js",
    "files:rekey": "tsx src/index.ts files:rekey",
    "accounts:export": "tsx src/index.ts accounts:export",
    "accounts:link": "tsx src/index.ts accounts:link",
    "accounts:readiness": "tsx src/index.ts accounts:readiness",
    "accounts:cleanup-check": "tsx src/index.ts accounts:cleanup-check"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.14",
    "@hono/node-server": "^2.1.6",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
