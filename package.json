{
  "name": "lotuspond-health",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "npm run dev -w server",
    "build": "tsc -b && vite build && npm run build -w server",
    "start": "npm start -w server",
    "local": "node tools/local.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b && npm run typecheck -w server",
    "test": "node tools/test-parsers.mjs && npm run test:app && npm run test:ocr && npm test -w server",
    "test:parsers": "node tools/test-parsers.mjs",
    "preview": "vite preview",
    "build:artifact": "node tools/build-artifact.mjs",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "build:mobile": "node tools/build-mobile.mjs && cap sync",
    "android": "npm run build:mobile && cap open android",
    "ios": "npm run build:mobile && cap open ios",
    "mobile:assets": "node tools/mobile-assets.mjs",
    "test:ocr": "node --import tsx --test --test-reporter=spec tools/test-ocr.ts",
    "test:app": "node --import tsx --test --test-reporter=spec tools/test-app-client.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/privacy-screen": "^2.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-health": "8.11.13",
    "@protomaps/basemaps": "^5.7.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "dicom-parser": "^1.8.21",
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^6.15.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suspend-react": "^0.1.3",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  }
}
