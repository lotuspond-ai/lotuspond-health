<?xml version="1.0" encoding="utf-8"?>
<!-- Health data stays on the device: nothing is copied to cloud backup (Android 12+).
     Direct device-to-device transfer, which the user starts themselves, is left at its default. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
