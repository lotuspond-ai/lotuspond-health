# Settings for deploy/docker-compose.yml. Copy with ./make-secrets.sh (it fills in the secrets), then edit.
# Keep the real .env out of git and backed up: losing DIRECTORY_SECRET or FILE_ENCRYPTION_KEY loses data.

DOMAIN=health.lotuspond.ai
# Let's Encrypt certificate notices.
ACME_EMAIL=ops@example.com

# Regions whose records this server may hold, given WHERE IT RUNS (in, eu, us, global; comma-separated).
# Sign-up tells people where their records are stored, so this must be true. A server in India: in.
# People from other regions are told sign-up is not available yet, until a server runs there.
SERVED_REGIONS=in

# Secrets (generated by make-secrets.sh).
POSTGRES_PASSWORD=
DIRECTORY_SECRET=
FILE_ENCRYPTION_KEY=

# Published contacts (Account page). India's DPDP Act requires a grievance contact.
# GRIEVANCE_CONTACT=Name, Grievance Officer, grievance@lotuspond.ai
# DPO_CONTACT=Data Protection Officer, dpo@lotuspond.ai

# OpenStreetMap's Nominatim asks for a contact address from apps that use it.
# GEO_CONTACT_EMAIL=ops@lotuspond.ai

# More settings (cells, region hosts for the apps, map tiles): server/.env.example.
