# Deploys the newest commit on its branch (DEPLOY_BRANCH in deploy/.env: main, or development on staging) if it is not running yet. Started by lotuspond-auto-deploy.timer.
# Installed by deploy/install-auto-deploy.sh; see deploy/ci-cd.md.
[Unit]
Description=LotusPond Health: deploy new commits on the server's branch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/opt/lotuspond-health/deploy/auto-deploy.sh
# A rebuild takes several minutes on the 4 GB plan.
TimeoutStartSec=45min
Nice=10
